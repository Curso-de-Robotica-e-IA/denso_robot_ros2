                            Show Axes: false
                            Show Trail: false
                          Value: true
                          calib_link:
                            Details:
                              Alpha: 1
                              Show Axes: false
                              Show Trail: false
                            Value: true
                        Value: true
                      Value: true
                    Value: true
                  Value: true
                Value: true
              Value: true
        Loop Animation: false
        Robot Alpha: 0.5
        Robot Color: 150; 50; 150
        Show Robot Collision: false
        Show Robot Visual: true
        Show Trail: false
        State Display Time: 0.05 s
        Trail Step Size: 1
        Trajectory Topic: /display_planned_path
