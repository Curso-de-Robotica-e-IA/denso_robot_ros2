<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg model)">
  <!-- robot name parameter -->
  <xacro:arg name="model" default="denso_robot" />
  <!-- import main macro -->
  <xacro:include filename="$(find denso_robot_descriptions)/robots/$(arg model)/urdf/denso_robot_macro.xacro" />

  <!-- parameters -->
  <xacro:arg name="namespace" default="" />
  <xacro:arg name="transmission_hw_interface" default="" />

  <!-- ros2_control related parameters -->
  <xacro:arg name="verbose" default="false" />
  <xacro:arg name="sim" default="false" />
  <xacro:arg name="gz_cam" default="false" />
  <xacro:arg name="ip_address" default="192.168.0.1" />
  <xacro:arg name="send_format" default="288" />
  <xacro:arg name="recv_format" default="292" />

  <xacro:arg name="xyz" default="0 0 0" />
  <xacro:arg name="rpy" default="0 0 0" />


  <!-- Root link -->
  <link name="world" />

  <!-- arm -->
  <xacro:denso_robot model="$(arg model)"
                     namespace="$(arg namespace)"
                     parent="world"
                     transmission_hw_interface="$(arg transmission_hw_interface)"
                     sim="$(arg sim)"
                     gz_cam="$(arg gz_cam)"
                     ip_address="$(arg ip_address)"
                     verbose="$(arg verbose)"
                     send_format="$(arg send_format)"
                     recv_format="$(arg recv_format)" >
    <origin xyz="$(arg xyz)" rpy="$(arg rpy)" />
  </xacro:denso_robot>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>
        $(find denso_robot_moveit_config)/robots/$(arg model)/config/denso_robot_controllers.yaml
      </parameters>
    </plugin>
  </gazebo>
</robot>
