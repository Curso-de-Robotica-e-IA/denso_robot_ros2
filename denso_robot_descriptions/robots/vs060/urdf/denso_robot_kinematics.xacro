<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="denso_robot_arm_kinematics" params="namespace model parent *origin">

    <joint name="${namespace}joint_w" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}" />
      <child link="${namespace}base_link" />
    </joint>

    <link name="${namespace}base_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/base_link.dae"
            scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/base_link.dae"
            scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="10.461" />
        <origin rpy="0.000000 0.000000 0.000000" xyz="-0.03869715 -0.00013435 0.09015562" />
        <inertia ixx="2.56287484e-05" ixy="0" ixz="0" iyy="4.04428633e-05" iyz="0"
          izz="3.52691555e-05" />
      </inertial>
    </link>

    <link name="${namespace}J1">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/J1.dae"
            scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/J1.dae"
            scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="4.857" />
        <origin rpy="0.000000 0.000000 0.000000" xyz="0.00876456 -0.00129251 0.0831962" />
        <inertia ixx="2.03436156e-05" ixy="0" ixz="0" iyy="1.43098790e-05" iyz="0"
          izz="1.33404841e-05" />
      </inertial>
    </link>
    <joint name="${namespace}joint_1" type="revolute">
      <parent link="${namespace}base_link" />
      <child link="${namespace}J1" />
      <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.181500" />
      <axis xyz="-0.000000 -0.000000 1.000000" />
      <!-- Initially, a negative effort value acting as a sentinel indicating "no limit" (treated as
      infinity) was used,
			but this was changed following the error on line 175 of 
			https://github.com/gazebosim/gz-physics/blob/ign-physics5/dartsim/src/JointFeatures.cc -->
      <limit effort="1e6" lower="${radians(-170)}" upper="${radians(170)}"
        velocity="${radians(425)}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <link name="${namespace}J2">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/J2.dae"
            scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/J2.dae"
            scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="6.830" />
        <origin rpy="0.000000 0.000000 0.000000" xyz="-0.01430033 -0.00011275 0.10801241" />
        <inertia ixx="5.11887760e-05" ixy="0" ixz="0" iyy="4.79804708e-05" iyz="0"
          izz="1.07669409e-05" />
      </inertial>
    </link>
    <joint name="${namespace}joint_2" type="revolute">
      <parent link="${namespace}J1" />
      <child link="${namespace}J2" />
      <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.163500" />
      <axis xyz="-0.000000 1.000000 -0.000000" />
      <!-- Initially, a negative effort value acting as a sentinel indicating "no limit" (treated as
      infinity) was used,
			but this was changed following the error on line 175 of 
			https://github.com/gazebosim/gz-physics/blob/ign-physics5/dartsim/src/JointFeatures.cc -->
      <limit effort="1e6" lower="${radians(-120)}" upper="${radians(120)}"
        velocity="${radians(283.33)}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <link name="${namespace}J3">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/J3.dae"
            scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/J3.dae"
            scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="3.352" />
        <origin rpy="0.000000 0.000000 0.000000" xyz="-0.00423762 0.0017248 0.05850176" />
        <inertia ixx="8.35358498e-06" ixy="0" ixz="0" iyy="8.39350395e-06" iyz="0"
          izz="2.68861407e-06" />
      </inertial>
    </link>
    <joint name="${namespace}joint_3" type="revolute">
      <parent link="${namespace}J2" />
      <child link="${namespace}J3" />
      <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.305000" />
      <axis xyz="-0.000000 1.000000 -0.000000" />
      <!-- Initially, a negative effort value acting as a sentinel indicating "no limit" (treated as
      infinity) was used,
			but this was changed following the error on line 175 of 
			https://github.com/gazebosim/gz-physics/blob/ign-physics5/dartsim/src/JointFeatures.cc -->
      <limit effort="1e6" lower="${radians(-25)}" upper="${radians(155)}"
        velocity="${radians(309.35)}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <link name="${namespace}J4">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/J4.dae"
            scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/J4.dae"
            scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="1.737" />
        <origin rpy="0.000000 0.000000 0.000000" xyz="-0.00091641 0.00242194 0.06198817" />
        <inertia ixx="2.99936270e-06" ixy="0" ixz="0" iyy="2.61340569e-06" iyz="0"
          izz="1.50956216e-06" />
      </inertial>
    </link>
    <joint name="${namespace}joint_4" type="revolute">
      <parent link="${namespace}J3" />
      <child link="${namespace}J4" />
      <origin rpy="0.000000 0.000000 0.000000" xyz="-0.010000 0.000000 0.164500" />
      <axis xyz="-0.000000 -0.000000 1.000000" />
      <limit effort="6.66" lower="${radians(-270)}" upper="${radians(270)}"
        velocity="${radians(425)}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <link name="${namespace}J5">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/J5.dae"
            scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/J5.dae"
            scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.721" />
        <origin rpy="0.000000 0.000000 0.000000" xyz="0.00122859 -0.00178514 0.00591313" />
        <inertia ixx="4.40135596e-07" ixy="0" ixz="0" iyy="5.27048557e-07" iyz="0"
          izz="2.67901836e-07" />
      </inertial>
    </link>
    <joint name="${namespace}joint_5" type="revolute">
      <parent link="${namespace}J4" />
      <child link="${namespace}J5" />
      <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.135500" />
      <axis xyz="-0.000000 1.000000 -0.000000" />
      <limit effort="6.66" lower="${radians(-120)}" upper="${radians(120)}"
        velocity="${radians(327.01)}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <link name="${namespace}J6">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/J6.dae"
            scale="1 1 1" />
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0" />
        <geometry>
          <mesh
            filename="file:///$(find denso_robot_descriptions)/robots/$(arg model)/meshes/J6.dae"
            scale="1 1 1" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.041" />
        <origin rpy="0.000000 0.000000 0.000000"
          xyz="-4.14785358e-06 -6.08836398e-05 -1.06013115e-02" />
        <inertia ixx="2.96882227e-09" ixy="0" ixz="0" iyy="2.99272641e-09" iyz="0"
          izz="4.56314494e-09" />
      </inertial>
    </link>
    <joint name="${namespace}joint_6" type="revolute">
      <parent link="${namespace}J5" />
      <child link="${namespace}J6" />
      <origin rpy="0.000000 0.000000 0.000000" xyz="0.000000 0.000000 0.070000" />
      <axis xyz="-0.000000 -0.000000 1.000000" />
      <limit effort="3.13" lower="${radians(-360)}" upper="${radians(360)}"
        velocity="${radians(680)}" />
      <dynamics damping="0" friction="0" />
    </joint>

    <link name="${namespace}flange" />
    <joint name="${namespace}J6-flange" type="fixed">
      <parent link="${namespace}J6" />
      <child link="${namespace}flange" />
      <origin rpy="0 ${radians(-90)} 0" xyz="0 0 0" />
    </joint>

    <link name="${namespace}tool0" />
    <joint name="${namespace}J6-tool0" type="fixed">
      <parent link="${namespace}J6" />
      <child link="${namespace}tool0" />
      <origin rpy="0 0 0" xyz="0 0 0" />
    </joint>
  </xacro:macro>
</robot>