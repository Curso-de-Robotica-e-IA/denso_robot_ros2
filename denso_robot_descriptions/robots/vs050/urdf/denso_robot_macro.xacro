<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!--
    Base Denso robot xacro macro.

    NOTE this is NOT a URDF. It cannot directly be loaded by consumers
    expecting a flattened '.urdf' file. See the top-level '.xacro' for that
    (but note that .xacro must still be processed by the xacro command).

    This file models the base kinematic chain of a Denso robot.

    Author DENSO WAVE INCORPORATED
  -->

  <xacro:macro name="denso_robot" params="
    model
    namespace
    parent
    *origin
    transmission_hw_interface:=hardware_interface/PositionJointInterface
    sim:=false
    basic_camera:=false
    calib_tool:=false
    calib_xyz:='0 0 0.05'
    calib_rpy:='0 0 0'
    calib_mesh_xyz:='0 0 -0.05'
    calib_mesh_rpy:='0 0 0'
    cellphone_holder:=false
    cellphone_holder_xyz:='-0.021230953 0 0.05367'
    cellphone_holder_rpy:='0 0 1.57079632679'
    cellphone_holder_mesh_xyz:='0 0 0.036991104'
    cellphone_holder_mesh_rpy:='0 0 1.57079632679'
    cellphone_holder_mesh_scale:='0.001 0.001 0.001'
    cellphone_holder_tag_size:=0.031
    virtual_phone:=false
    virtual_phone_width:=0.070
    virtual_phone_height:=0.150
    virtual_phone_thickness:=0.008
    virtual_phone_screen_offset:=0.0
    ip_address
    send_format
    recv_format
    verbose:=false"
  >

    <!-- Robot data required by the denso driver -->
    <xacro:arg name="ip_address" default=""/>
    <xacro:arg name="robot_name" default="VS050A3-AV6-NNN-NNN A"/> <!-- "robot_name" param must be consistent with the @TYPE_NAME variable of the real robot !! -->
    <xacro:arg name="robot_joints" default="6"/> <!-- number of total joints in the kinematic chain -->
    <xacro:arg name="joint_1" default="1"/> <!-- 0 = prismatic , 1 = revolute -->
    <xacro:arg name="joint_2" default="1"/> <!-- 0 = prismatic , 1 = revolute -->
    <xacro:arg name="joint_3" default="1"/> <!-- 0 = prismatic , 1 = revolute -->
    <xacro:arg name="joint_4" default="1"/> <!-- 0 = prismatic , 1 = revolute -->
    <xacro:arg name="joint_5" default="1"/> <!-- 0 = prismatic , 1 = revolute -->
    <xacro:arg name="joint_6" default="1"/> <!-- 0 = prismatic , 1 = revolute -->
    <xacro:arg name="controller_type" default="8"/> <!-- 8 = RC8 , 9 = RC9 -->
    <xacro:arg name="arm_group" default="0"/>
    <xacro:arg name="send_format" default="288"/>
    <xacro:arg name="recv_format" default="292"/>
    <xacro:arg name="verbose" default="false"/>

    <!-- initial position for simulations-->
    <xacro:arg name="initial_positions_file" default="$(find denso_robot_descriptions)/robots/$(arg model)/initial_positions.yaml"/>

    <!-- convert to property to use substitution in function -->
    <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>

    <xacro:include filename="$(find denso_robot_descriptions)/robots/$(arg model)/urdf/denso_robot_transmissions.xacro" />
    <!-- robot kinematics include -->
    <xacro:include filename="$(find denso_robot_descriptions)/robots/$(arg model)/urdf/denso_robot_kinematics.xacro" />
    <!-- ros2 control include -->
    <xacro:include filename="$(find denso_robot_descriptions)/robots/$(arg model)/urdf/denso_robot.ros2_control.xacro" />

    <!-- For other tools, modify the filename parameter to the path of your tool's xacro file. -->
    <!-- The line with tag xacro:tool passes the parameters defined in your tool's xacro file -->
    <!-- (see basic_camera.xacro as an example implementation) -->
    <xacro:if value="${basic_camera}">
      <xacro:include filename="$(find denso_robot_descriptions)/tools/basic_camera/urdf/basic_camera.xacro" />
    </xacro:if>

    <xacro:if value="${calib_tool and not basic_camera}">
      <xacro:include filename="$(find denso_robot_descriptions)/tools/calibration_tool/urdf/calib.xacro" />
    </xacro:if>

    <xacro:if value="${cellphone_holder}">
      <xacro:include filename="$(find denso_robot_descriptions)/tools/cellphone_holder/urdf/cellphone_holder.xacro" />
    </xacro:if>
    
    <!-- ros2 control instance -->
    <xacro:denso_robot_ros2_control
      name="GazeboSystem" namespace="${namespace}"
      sim="$(arg sim)"
      model="$(arg model)"
      ip_address="${ip_address}"
      robot_name="$(arg robot_name)"
      robot_joints="$(arg robot_joints)"
      joint_1="$(arg joint_1)"
      joint_2="$(arg joint_2)"
      joint_3="$(arg joint_3)"
      joint_4="$(arg joint_4)"
      joint_5="$(arg joint_5)"
      joint_6="$(arg joint_6)"
      arm_group="$(arg arm_group)"
      controller_type="$(arg controller_type)"
      verbose="$(arg verbose)"
      send_format="$(arg send_format)"
      recv_format="$(arg recv_format)"
      initial_positions="${xacro.load_yaml(initial_positions_file)}" />

    <!-- Add URDF transmission elements (for ros_control) -->
    <xacro:denso_robot_arm_transmission namespace="${namespace}" hw_interface="$(arg transmission_hw_interface)" />
    <!-- Placeholder for ros2_control transmission which don't yet exist -->

    <!-- links -  main serial chain -->
    <xacro:denso_robot_arm_kinematics namespace="${namespace}" model="$(arg model)" parent="${parent}" >
      <xacro:insert_block name="origin" />
    </xacro:denso_robot_arm_kinematics>

    <xacro:if value="${basic_camera}">
      <xacro:basic_camera namespace="${namespace}" end_effector="J6" />
    </xacro:if>

    <xacro:if value="${calib_tool and not basic_camera}">
      <xacro:calib
        namespace="${namespace}"
        end_effector="J6"
        xyz="${calib_xyz}"
        rpy="${calib_rpy}"
        mesh_xyz="${calib_mesh_xyz}"
        mesh_rpy="${calib_mesh_rpy}" />
    </xacro:if>

    <xacro:if value="${cellphone_holder}">
      <xacro:cellphone_holder
        namespace="${namespace}"
        end_effector="J6"
        xyz="${cellphone_holder_xyz}"
        rpy="${cellphone_holder_rpy}"
        mesh_xyz="${cellphone_holder_mesh_xyz}"
        mesh_rpy="${cellphone_holder_mesh_rpy}"
        mesh_scale="${cellphone_holder_mesh_scale}"
        tag_size="${cellphone_holder_tag_size}"
        virtual_phone="${virtual_phone}"
        virtual_phone_width="${virtual_phone_width}"
        virtual_phone_height="${virtual_phone_height}"
        virtual_phone_thickness="${virtual_phone_thickness}"
        virtual_phone_screen_offset="${virtual_phone_screen_offset}" />
    </xacro:if>
  </xacro:macro>
</robot>
