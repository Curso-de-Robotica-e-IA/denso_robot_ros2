<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

	<xacro:macro name="calib" params="namespace end_effector xyz rpy mesh_xyz:='0 0 0' mesh_rpy:='0 0 0'">
    <link name="${namespace}calib_link">
		<inertial>
			<origin rpy="${rpy}" xyz="${xyz}"/>
			<mass value="0.1"/>
			<inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
		</inertial>
		<collision>
			<origin rpy="${mesh_rpy}" xyz="${mesh_xyz}"/>
			<geometry>
				<mesh filename="file:///$(find denso_robot_descriptions)/tools/calibration_tool/meshes/calibration_tool.dae" scale="1 1 1"/>
			</geometry>
		</collision>
		<visual>
			<material name="calib_material">
				<color rgba="0.8 0.1 0.1 1"/>
			</material>
			<origin rpy="${mesh_rpy}" xyz="${mesh_xyz}"/>
			<geometry>
				<mesh filename="file:///$(find denso_robot_descriptions)/tools/calibration_tool/meshes/calibration_tool.dae" scale="1 1 1"/>
			</geometry>
		</visual>
	</link>

	<joint name="${namespace}calib_joint" type="fixed">
		<parent link="${namespace}${end_effector}"/>
		<child link="${namespace}calib_link"/>
		<origin rpy="${rpy}" xyz="${xyz}"/>
	</joint>
    </xacro:macro>
</robot>
