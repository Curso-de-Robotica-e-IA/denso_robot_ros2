<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- here you define the parameters you want your xacro file to receive. -->
    <xacro:macro name="basic_camera" params="namespace end_effector">

    <!-- if your tool has meshes, define the path to it in geometry tag. -->
    <!-- see the vs050 robot urdf implementation as an example. -->
    <material name="${namespace}basic_camera_body_material">
      <color rgba="0.05 0.16 0.30 1.0"/>
    </material>
    <material name="${namespace}basic_camera_view_axis_material">
      <color rgba="0.0 0.75 1.0 0.55"/>
    </material>

    <link name="${namespace}basic_camera_link">
		<inertial>
			<mass value="1"/>
			<inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1"/>
		</inertial>
		<collision>
			<geometry>
				<box size="0.035 0.03 0.025"/> 
			</geometry>
		</collision>
		<visual>
			<geometry>
				<box size="0.035 0.03 0.025"/> 
			</geometry>
      <material name="${namespace}basic_camera_body_material"/>
		</visual>
	</link>

  <link name="${namespace}basic_camera_view_axis">
    <visual>
      <origin rpy="0 1.57079632679 0" xyz="0.13 0 0"/>
      <geometry>
        <cylinder length="0.26" radius="0.003"/>
      </geometry>
      <material name="${namespace}basic_camera_view_axis_material"/>
    </visual>
  </link>

  <joint name="${namespace}basic_camera_view_axis_joint" type="fixed">
    <parent link="${namespace}basic_camera_link"/>
    <child link="${namespace}basic_camera_view_axis"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>

	<joint name="${namespace}basic_camera_joint" type="fixed">
        <!-- here you define where your tool will connect. In this case, it's at joint 6. -->
		<parent link="${namespace}${end_effector}"/> 
		<child link="${namespace}basic_camera_link"/>
		<origin rpy="0 ${radians(-90)} 0" xyz="0 0 0.01"/>
	</joint>

    <gazebo reference="${namespace}basic_camera_link">
      <sensor name="${namespace}basic_camera" type="camera">
        <camera>
          <horizontal_fov>2.09439510239</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <!-- Keep simulation and RViz responsive while preserving enough rate for alignment. -->
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>${namespace}basic_camera</topic>      
      </sensor>
    </gazebo>
    </xacro:macro>
</robot>
