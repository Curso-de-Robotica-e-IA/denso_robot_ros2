<?xml version='1.0'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="gz_cam" params="namespace">
      <!-- You should always attach the flange -->
      <gazebo reference="${namespace}flange">
      <!-- others specs can be add for camera sensor https://sdformat.org/spec/1.9/sensor/#sensor_camera -->
        <sensor name="${namespace}gz_cam" type="camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>${namespace}gz_cam</topic>      
        </sensor>
      </gazebo>
    </xacro:macro>
</robot>